# =====================================================================
# Aletheia — .gitignore
# =====================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test / lint / type
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
pytest-cache-files-*/

# Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Aletheia — datos sensibles (NO subir a repo público)
data/private/
data/patient_data/
*.private.csv
*.private.tsv
uploads/
sessions/
runtime_state/

# Aletheia — outputs locales que cambian a cada ejecución
outputs/
exports/
reports/local/
*.parquet
*.feather

# Logs
*.log
logs/

# Reportes generados (excepto los curados en docs/)
*.pdf
!docs/**/*.pdf
!docs/figures/*.pdf

# Secrets / config local
.env
.env.local
.env.*.local
secrets.toml
config.local.*
*.pem
*.key

# Cowork / Claude scratch
.cowork/
.claude/scratch/

# Dash / Flask runtime
instance/
flask_session/

# Internal agent notes — not for the public repo
CLAUDE.md
.claude/

# Ad-hoc debug / smoke scripts (leading underscore = private/experimental)
aletheia/_*.py
!aletheia/__init__.py
aletheia/test_*.py
*.pyc
benchmark_aletheia_run/
